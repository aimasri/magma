{
    "name": "magma/framework",
    "description": "Magma Framework Core - Educational Architecture",
    "type": "project",
    "require": {},
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Magma\\": "magma/",
            "Modules\\": "modules/",
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
